{
    "manifest_version": 3,
    "name": "Salesforce Comet",
    "version": "3.1.3",
    "homepage_url": "https://github.com/salesforcecomet/Salesforcecomet.github.io",
    "minimum_chrome_version": "111",
    "description": "Powerful Salesforce development tools for inspecting data, metadata, and debugging.",
    "author": "Salesforce Comet",
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "storage",
        "cookies",
        "scripting",
        "alarms",
        "contextMenus"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/local-fonts.css",
                "src/fonts/*.ttf",
                "src/flow-name-extractor.js",
                "icons/icon-48.png",
                "icons/icon-16.png",
                "icons/icon-128.png"
            ],
            "matches": [
                "https://*.salesforce.com/*",
                "https://*.force.com/*",
                "https://*.salesforce-setup.com/*",
                "https://*.visualforce.com/*",
                "https://*.lightning.force.com/*",
                "https://*.my.salesforce.com/*",
                "https://*.sandbox.lightning.force.com/*",
                "https://*.develop.lightning.force.com/*",
                "https://*.trailblaze.my.salesforce.com/*",
                "https://login.salesforce.com/*",
                "https://test.salesforce.com/*"
            ],
            "use_dynamic_url": true
        }
    ],
    "host_permissions": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.visualforce.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.sandbox.lightning.force.com/*",
        "https://*.develop.lightning.force.com/*",
        "https://*.trailblaze.my.salesforce.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://*.salesforce.com/*",
                "https://*.force.com/*",
                "https://*.salesforce-setup.com/*",
                "https://*.visualforce.com/*",
                "https://*.lightning.force.com/*",
                "https://*.my.salesforce.com/*"
            ],
            "exclude_matches": [
                "https://trailhead.salesforce.com/*",
                "https://help.salesforce.com/*",
                "https://*.digital.salesforce.com/*"
            ],
            "js": [
                "src/flow-scanner-content/interceptor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://*.salesforce.com/*",
                "https://*.force.com/*",
                "https://*.salesforce-setup.com/*",
                "https://*.visualforce.com/*",
                "https://*.lightning.force.com/*",
                "https://*.my.salesforce.com/*",
                "https://*.sandbox.lightning.force.com/*",
                "https://*.develop.lightning.force.com/*",
                "https://*.trailblaze.my.salesforce.com/*"
            ],
            "exclude_matches": [
                "https://trailhead.salesforce.com/*",
                "https://help.salesforce.com/*",
                "https://*.digital.salesforce.com/*"
            ],
            "css": [
                "src/glass-toast.css",
                "src/flow-scanner-content/overlay-ui.css",
                "src/custom-dropdown.css"
            ],
            "js": [
                "src/glass-toast.js",
                "src/colored-favicon.js",
                "src/api.js",
                "src/user-permissions.js",
                "src/custom-tooltip.js",
                "src/performance.js",
                "src/content.js",
                "src/flow-scanner-engine/flow-scanner-bundle.js",
                "src/flow-scanner-content/overlay-ui.js",
                "src/flow-scanner-content/content-script.js",
                "src/custom-dropdown.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://login.salesforce.com/*",
                "https://test.salesforce.com/*",
                "https://*.my.salesforce.com/*",
                "https://*.salesforce.com/*",
                "https://*.force.com/*",
                "https://*.lightning.force.com/*"
            ],
            "exclude_matches": [
                "https://trailhead.salesforce.com/*",
                "https://help.salesforce.com/*",
                "https://*.digital.salesforce.com/*"
            ],
            "js": [
                "src/login-injector.js"
            ],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "src/background.js"
    },
    "action": {
        "default_title": "Salesforce Comet",
        "default_popup": "src/popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://*.salesforce.com https://*.force.com https://*.lightning.force.com https://*.visualforce.com https://*.cloudforce.com blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:"
    }
}
